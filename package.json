{
  "name": "roomview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first 2D/3D room layout editor with an AI command API",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:demo": "node tests/demo.browser.mjs",
    "ai": "node scripts/roomview-cli.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "playwright": "^1.55.0"
  },
  "license": "MIT"
}
